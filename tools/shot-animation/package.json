{
  "name": "grmod-shot-animation-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "verify:browser": "node verify-browser.mjs",
    "render:previews": "node render-previews.mjs",
