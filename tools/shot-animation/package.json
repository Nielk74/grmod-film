    "export:legacy": "node export.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.540",
    "gsap": "3.15.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "playwright": "1.62.1",
    "sharp": "0.34.5",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
