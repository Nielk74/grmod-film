      "css": ".ds-camera{background:#252729;border-radius:12px;padding:12px 12px 0;box-shadow:0 8px 16px #202a2417}.ds-top{display:flex;align-items:center;height:25px;padding:0 1px 8px}.ds-top span{font:italic 700 18px Arial,sans-serif;color:#c6c7c1;letter-spacing:-1px}.ds-lcd{position:relative;aspect-ratio:3/2;overflow:hidden;background:#1a231e;border-radius:3px}.ds-chin{height:28px;display:flex;align-items:center;color:#92968e;font:7px Arial,sans-serif;letter-spacing:1.5px;padding:0 3px;gap:15px}.ds-chin i{height:1px;background:#4c5150;flex:1}@media(max-width:790px){.ds-top{height:30px}.ds-chin{height:32px}}"
