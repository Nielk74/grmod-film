    {
      "name": "Shutter button",
      "kind": "button",
      "refersTo": "button-shutter",
      "description": "Trigger a randomly selected complete shot.",
      "html": "<button class=\"ds-shutter\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h4l2-3h4l2 3h4v13H4Z\"/><circle cx=\"12\" cy=\"13\" r=\"4\"/></svg>Take a picture</button>",
      "css": ".ds-shutter{display:flex;align-items:center;gap:10px;border:0;background:#25312f;color:#fff1d6;padding:13px 17px;border-radius:6px;font:700 12px Arial,sans-serif;cursor:pointer}.ds-shutter svg{width:20px;height:20px}.ds-shutter:hover{background:#3e534a}.ds-shutter:focus-visible{outline:3px solid var(--accent,#af4932);outline-offset:5px}"
    },
    {
      "name": "Stage replay button",
      "kind": "button",
      "refersTo": "button-replay",
      "description": "Replay the selected study after its stage clears.",
      "html": "<button class=\"ds-replay\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 10 7-10 7Z\"/></svg>Replay Pixel Portal</button>",
      "css": ".ds-replay{display:flex;align-items:center;gap:9px;border:0;padding:12px 16px;background:#25312f;color:#fff1d6;border-radius:5px;font:12px Arial,sans-serif;cursor:pointer}.ds-replay svg{width:20px;height:20px}.ds-replay:hover{background:#3e534a}.ds-replay:focus-visible{outline:3px solid var(--accent,#af4932);outline-offset:5px}"
    },
    {
      "name": "Sequence Play action",
      "kind": "button",
      "description": "Ruled action for inspecting a particular transition.",
      "html": "<button class=\"ds-audition\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 10 7-10 7Z\"/></svg><span>Play Pixel Portal</span></button>",
      "css": ".ds-audition{width:100%;display:flex;align-items:center;gap:7px;text-align:left;background:none;border:0;border-top:1px solid var(--rule,#cdcdbd);padding:16px 0;font:12px Arial,sans-serif;color:var(--accent,#af4932);cursor:pointer}.ds-audition svg{width:15px;height:15px}.ds-audition:hover{color:var(--accent,#af4932)}.ds-audition:focus-visible{outline:3px solid var(--accent,#af4932);outline-offset:5px}"
    },
    {
      "name": "Animation timeline",
