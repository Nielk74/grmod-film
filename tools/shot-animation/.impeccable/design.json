      "html": "<nav class=\"ds-nav\"><a class=\"ds-wordmark\" href=\"#preview\">GR<span>MOD</span><i></i>SHUTTER STUDIES</a><a class=\"ds-source\" href=\"https://github.com/Maxwooow/Ricoh-GRMod\">Made for the little camera<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></a></nav>",
      "css": ".ds-nav{height:92px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule,#cdcdbd);gap:20px}.ds-wordmark{display:flex;align-items:center;text-decoration:none;font:700 11px Arial,sans-serif;letter-spacing:1.3px;color:#25312f}.ds-wordmark span{color:var(--accent,#af4932);margin-left:3px}.ds-wordmark i{height:18px;width:1px;background:#92998b;margin:0 19px}.ds-source{font:12px Arial,sans-serif;text-decoration:none;color:var(--quiet,#62695f);text-underline-offset:5px}.ds-source:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--accent,#af4932);outline-offset:5px}@media(max-width:790px){.ds-source{display:none}}.ds-source svg{width:13px;height:13px;margin-left:10px;vertical-align:middle}"
    },
